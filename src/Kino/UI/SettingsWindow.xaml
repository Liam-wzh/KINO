<ui:FluentWindow x:Class="Kino.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Kino.UI"
        Title="KINO 设置" Icon="/KINO;component/Assets/kino.ico" Width="820" Height="730" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition /></Grid.RowDefinitions>
        <ui:TitleBar Title="KINO 设置" ShowMinimize="False" ShowMaximize="False" />
    <Grid Grid.Row="1">
        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <StackPanel Margin="14,22,10,20">
            <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource KinoAccentSoftBrush}" HorizontalAlignment="Left" Margin="14,0,0,12"><Rectangle Style="{StaticResource KinoLogoStyle}" Width="27" Height="27" /></Border>
            <TextBlock Text="KINO" FontSize="22" FontWeight="SemiBold" Margin="14,0,0,4" />
            <TextBlock Text="AI 用量，抬眼可见。" FontSize="11" Foreground="{DynamicResource KinoMutedBrush}" Margin="14,0,0,25" />
            <ListBox x:Name="Navigation" SelectionChanged="PageChanged" BorderThickness="0" Background="Transparent" Padding="0">
                <ListBoxItem Padding="12,11" Tag="0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Margin="0,2,10,0" /><TextBlock Text="站点连接" /></StackPanel></ListBoxItem>
                <ListBoxItem Padding="12,11" Tag="1"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Margin="0,2,10,0" /><TextBlock Text="显示内容" /></StackPanel></ListBoxItem>
                <ListBoxItem Padding="12,11" Tag="2"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" Margin="0,2,10,0" /><TextBlock Text="外观与刷新" /></StackPanel></ListBoxItem>
                <ListBoxItem Padding="12,11" Tag="3"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" Margin="0,2,10,0" /><TextBlock Text="余额提醒" /></StackPanel></ListBoxItem>
            </ListBox>
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource KinoSurfaceBrush}" CornerRadius="9,0,0,0" BorderBrush="{DynamicResource KinoBorderBrush}" BorderThickness="1,1,0,0" Margin="0,8,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="27,20,27,24" Style="{DynamicResource {x:Type ScrollViewer}}">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="站点连接" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBlock x:Name="PageDescription" Text="连接你的中转站，在任务栏查看用量。" Foreground="{DynamicResource KinoMutedBrush}" Margin="0,0,0,24" FontSize="12" />
                    <StackPanel x:Name="ConnectionPage">
                        <Border Background="{DynamicResource KinoAccentSoftBrush}" CornerRadius="7" Padding="12" Margin="0,0,0,18">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="连接你的中转站" FontWeight="SemiBold" /><TextBlock Text="支持 New API 与 Sub2API 自定义站点。" FontSize="11" Foreground="{DynamicResource KinoMutedBrush}" Margin="0,4,8,0" /></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ManageSitesButton" Content="管理站点" Click="ManageSitesClicked" Padding="12,6" Margin="0,0,8,0" /><Button Content="连接向导" Click="GuideClicked" Padding="12,6" /></StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="平台" Style="{StaticResource FormLabel}" />
                        <ComboBox x:Name="ProviderBox" SelectionChanged="ProviderChanged" Margin="0,0,0,17">
                            <ComboBoxItem Content="演示模式" /><ComboBoxItem Content="New API" /><ComboBoxItem Content="Sub2API" />
                        </ComboBox>
                        <TextBlock Text="站点名称" Style="{StaticResource FormLabel}" />
                        <TextBox x:Name="SiteNameBox" Margin="0,0,0,17" />
                        <StackPanel x:Name="CredentialsPanel">
                            <TextBlock Text="站点地址" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="UrlBox" TextChanged="AddressChanged" Margin="0,0,0,4" />
                            <TextBlock Text="例如 https://api.example.com，支持站点部署在子目录。" FontSize="11" Foreground="{DynamicResource KinoMutedBrush}" Margin="0,0,0,17" />
                            <StackPanel x:Name="Sub2AuthPanel" Margin="0,0,0,17">
                                <TextBlock Text="认证方式" Style="{StaticResource FormLabel}" />
                                <ComboBox x:Name="Sub2AuthBox" SelectionChanged="ProviderChanged"><ComboBoxItem Content="API Key（当前 Key 用量）" /><ComboBoxItem Content="账户访问令牌 JWT（整个账户）" /></ComboBox>
                            </StackPanel>
                            <TextBlock x:Name="TokenLabel" Text="用户访问令牌" Style="{StaticResource FormLabel}" />
                            <PasswordBox x:Name="TokenBox" Margin="0,0,0,6" />
                            <TextBlock x:Name="TokenHelp" FontSize="11" Foreground="{DynamicResource KinoMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,17" />
                            <StackPanel x:Name="NewApiPanel">
                                <Button x:Name="SecurityButton" Content="打开安全设置，创建用户访问令牌  ↗" Click="SecurityClicked" HorizontalAlignment="Left" Margin="0,0,0,17" Padding="10,6" />
                                <TextBlock Text="用户 ID（部分版本必填）" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="UserIdBox" Margin="0,0,0,14" />
                                <CheckBox x:Name="AutoQuotaBox" Content="自动读取站点额度换算比例" Margin="0,0,0,9" />
                                <TextBlock Text="备用换算比例 · 每 1 USD 对应的额度" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="QuotaBox" Margin="0,0,0,17" />
                            </StackPanel>
                        </StackPanel>
                        <Border Background="{DynamicResource KinoAccentSoftBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,17">
                            <TextBlock x:Name="ConnectionHint" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource KinoMutedBrush}" />
                        </Border>
                        <Button x:Name="TestButton" Content="测试连接" Click="TestClicked" HorizontalAlignment="Left" MinWidth="100" />
                        <TextBlock x:Name="TestResult" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12" />
                    </StackPanel>
                    <StackPanel x:Name="DisplayPage" Visibility="Collapsed">
                        <TextBlock Text="任务栏预览" Style="{StaticResource SectionLabel}" />
                        <Border Background="{DynamicResource KinoSurfaceBrush}" BorderBrush="{DynamicResource KinoBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="13,9" Margin="0,0,0,20">
                            <StackPanel><TextBlock x:Name="PreviewLine1" FontSize="12" FontFamily="Consolas, Microsoft YaHei UI" /><TextBlock x:Name="PreviewLine2" FontSize="12" FontFamily="Consolas, Microsoft YaHei UI" Margin="0,4,0,0" /></StackPanel>
                        </Border>
                        <TextBlock Text="勾选显示项，使用箭头调整顺序。任务栏至少保留一项。" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource KinoMutedBrush}" Margin="0,0,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="任务栏" FontWeight="SemiBold" Margin="0,0,0,9" /><StackPanel x:Name="TaskbarOptions" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="展开卡片" FontWeight="SemiBold" Margin="0,0,0,9" /><StackPanel x:Name="CardOptions" /></StackPanel>
                        </Grid>
                        <CheckBox x:Name="ChartBox" Content="卡片中显示消费趋势" Margin="0,20,0,9" />
                        <CheckBox x:Name="ModelsBox" Content="卡片中显示模型用量" />
                        <TextBlock Text="卡片余额与连接状态显示在顶部，其余指标按所选顺序排列。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource KinoMutedBrush}" Margin="0,15,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="AlertsPage" Visibility="Collapsed">
                        <TextBlock x:Name="AlertSiteLabel" TextWrapping="Wrap" Foreground="{DynamicResource KinoAccentBrush}" FontSize="12" Margin="0,0,0,20" />
                        <local:BalanceAlertEditor x:Name="AlertEditor" />
                    </StackPanel>
                    <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
                        <TextBlock Text="卡片主题" Style="{StaticResource FormLabel}" />
                        <ComboBox x:Name="ThemeBox" Margin="0,0,0,19"><ComboBoxItem Content="跟随系统" /><ComboBoxItem Content="浅色" /><ComboBoxItem Content="深色" /></ComboBox>
                        <TextBlock Text="自动刷新间隔" Style="{StaticResource FormLabel}" />
                        <ComboBox x:Name="IntervalBox" IsEditable="True" Margin="0,0,0,5"><ComboBoxItem Content="15" /><ComboBoxItem Content="30" /><ComboBoxItem Content="60" /><ComboBoxItem Content="120" /><ComboBoxItem Content="300" /></ComboBox>
                        <TextBlock Text="单位：秒，范围 15–3600。建议 60 秒或更久。" FontSize="11" Foreground="{DynamicResource KinoMutedBrush}" Margin="0,0,0,19" />
                        <TextBlock Text="任务栏向左 / 向上偏移" Style="{StaticResource FormLabel}" />
                        <TextBox x:Name="OffsetBox" Margin="0,0,0,5" />
                        <TextBlock Text="单位：DIP。与其他任务栏工具重叠时可调整此值。" FontSize="11" Foreground="{DynamicResource KinoMutedBrush}" Margin="0,0,0,19" />
                        <CheckBox x:Name="PrivacyBox" Content="隐藏任务栏和卡片中的金额" Margin="0,0,0,24" />
                        <Border Background="{DynamicResource KinoAccentSoftBrush}" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="VersionText" Text="KINO" FontWeight="SemiBold" Margin="0,0,0,7" />
                                <TextBlock Text="C# · WPF · Direct2D · Fluent" FontSize="12" Margin="0,0,0,6" />
                                <TextBlock Text="设置保存在当前 Windows 用户目录。令牌由 Windows DPAPI 加密，无需管理员权限。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource KinoMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource KinoBorderBrush}" BorderThickness="0,1,0,0" Padding="20,13">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveMessage" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource KinoMutedBrush}" TextWrapping="Wrap" Margin="0,0,15,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消" MinWidth="80" Click="CancelClicked" Margin="0,0,8,0" />
                    <ui:Button x:Name="SaveButton" Content="保存并应用" MinWidth="110" Click="SaveClicked" Appearance="Primary" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</ui:FluentWindow>
